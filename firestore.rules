rules_version = '2';
// Règles publiées dans la console Firebase (référence versionnée ici) :
// chaque utilisateur ne lit et n'écrit que ses propres données, et seulement connecté.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
