{
  "name": "ascend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ascend \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:e2e && npm run test:rules",
    "check:links": "tsx scripts/check-links.ts",
    "unused": "knip",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "firebase": "10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7"
  }
}
